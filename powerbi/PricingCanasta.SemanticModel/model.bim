      },
      {
        "name": "Calendario",
        "description": "Dimension calendario compartida por todos los marts diarios.",
        "dataCategory": "Time",
        "columns": [
          {
            "name": "Fecha",
            "dataType": "dateTime",
            "sourceColumn": "Fecha",
            "formatString": "yyyy-MM-dd",
            "summarizeBy": "none"
          },
          {
            "name": "Anio",
            "dataType": "int64",
            "sourceColumn": "Anio",
            "formatString": "0",
            "summarizeBy": "none"
          },
          {
            "name": "Mes numero",
            "dataType": "int64",
            "sourceColumn": "Mes numero",
            "formatString": "0",
            "summarizeBy": "none"
          },
          {
            "name": "Mes",
            "dataType": "string",
            "sourceColumn": "Mes",
            "sortByColumn": "Mes numero",
            "summarizeBy": "none"
          },
          {
            "name": "Dia",
            "dataType": "string",
            "sourceColumn": "Dia",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Calendario",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    StartDate = #date(2026, 7, 27),\n    EndDate = #date(2026, 8, 2),\n    Dates = List.Dates(StartDate, Duration.Days(EndDate - StartDate) + 1, #duration(1, 0, 0, 0)),\n    Source = Table.FromList(Dates, Splitter.SplitByNothing(), {\"Fecha\"}),\n    Typed = Table.TransformColumnTypes(Source, {{\"Fecha\", type date}}),\n    AddYear = Table.AddColumn(Typed, \"Anio\", each Date.Year([Fecha]), Int64.Type),\n    AddMonthNumber = Table.AddColumn(AddYear, \"Mes numero\", each Date.Month([Fecha]), Int64.Type),\n    AddMonth = Table.AddColumn(AddMonthNumber, \"Mes\", each Date.ToText([Fecha], \"MMM\", \"es-AR\"), type text),\n    AddDay = Table.AddColumn(AddMonth, \"Dia\", each Date.ToText([Fecha], \"ddd\", \"es-AR\"), type text)\nin\n    AddDay"
            }
          }
        ]
      },
      {
        "name": "Medidas",
        "description": "Medidas ejecutivas y de calidad del reporte.",
        "columns": [
          {
            "name": "Valor",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "Valor"
          }
        ],
        "partitions": [
          {
            "name": "Medidas",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "#table(type table [Valor = Int64.Type], {{1}})"
            }
          }
        ],
        "measures": [
          {
            "name": "Indice precio",
            "description": "Indice relativo sobre el benchmark geometrico del panel comun.",
            "expression": "MEDIAN('index_daily'[price_index])",
            "formatString": "0.00"
          },
          {
            "name": "GTIN comunes ultimo dia",
            "description": "Menor cantidad de GTIN comunes entre cadenas en el ultimo corte disponible.",
            "expression": "VAR Fecha = MAXX(ALL('index_daily'), 'index_daily'[snapshot_date])\nRETURN\n    CALCULATE(MIN('index_daily'[common_gtins]), 'index_daily'[snapshot_date] = Fecha)",
            "formatString": "#,0"
          },
          {
            "name": "Indice semanal",
            "description": "Mediana entre los indices geometricos por cadena en la ventana observada.",
            "expression": "MEDIAN('index_7d'[geometric_mean_index])",
            "formatString": "0.00"
          },
          {
            "name": "Sensibilidad maxima",
            "description": "Mayor diferencia entre escenarios de sensibilidad.",
            "expression": "MAX('index_sensitivity'[sensitivity_delta])",
            "formatString": "0.00"
          },
          {
            "name": "Costo canasta ultimo corte",
            "description": "Mediana de los costos por cadena publicable en el ultimo corte.",
            "expression": "VAR Fecha = MAXX(ALL('basket_banner'), 'basket_banner'[snapshot_date])\nRETURN\n    CALCULATE(\n        MEDIAN('basket_banner'[branch_median_cost]),\n        'basket_banner'[snapshot_date] = Fecha,\n        'basket_banner'[coverage_status] = \"PUBLISHABLE\"\n    )",
            "formatString": "$ #,0"
          },
          {
            "name": "Costo canasta provincia",
            "description": "Costo mediano provincial publicable en el ultimo corte.",
            "expression": "VAR Fecha = MAXX(ALL('basket_province'), 'basket_province'[snapshot_date])\nRETURN\n    CALCULATE(\n        MEDIAN('basket_province'[branch_median_cost]),\n        'basket_province'[snapshot_date] = Fecha,\n        'basket_province'[coverage_status] = \"PUBLISHABLE\"\n    )",
            "formatString": "$ #,0"
          },
          {
            "name": "Sucursales canasta completa",
            "description": "Sucursales con los ocho componentes disponibles en el ultimo corte.",
            "expression": "VAR Fecha = MAXX(ALL('basket_banner'), 'basket_banner'[snapshot_date])\nRETURN\n    CALCULATE(\n        SUM('basket_banner'[complete_stores]),\n        'basket_banner'[snapshot_date] = Fecha\n    )",
            "formatString": "#,0"
          },
          {
            "name": "Completitud canasta",
            "description": "Proporcion de sucursales activas con canasta completa en el ultimo corte.",
            "expression": "VAR Fecha = MAXX(ALL('basket_banner'), 'basket_banner'[snapshot_date])\nVAR Completas = CALCULATE(SUM('basket_banner'[complete_stores]), 'basket_banner'[snapshot_date] = Fecha)\nVAR Activas = CALCULATE(SUM('basket_banner'[active_stores]), 'basket_banner'[snapshot_date] = Fecha)\nRETURN\n    DIVIDE(Completas, Activas)",
            "formatString": "0.0%"
          },
          {
            "name": "Ahorro canasta",
            "description": "Diferencia entre la cadena mas cara y la mas barata en el ultimo corte.",
            "expression": "VAR Fecha = MAXX(ALL('basket_savings'), 'basket_savings'[snapshot_date])\nRETURN\n    CALCULATE(\n        MAX('basket_savings'[potential_saving_amount]),\n        'basket_savings'[snapshot_date] = Fecha,\n        'basket_savings'[comparison_level] = \"BANNER\"\n    )",
            "formatString": "$ #,0"
          },
          {
            "name": "Ahorro canasta porcentaje",
            "description": "Ahorro porcentual potencial entre cadenas en el ultimo corte.",
            "expression": "VAR Fecha = MAXX(ALL('basket_savings'), 'basket_savings'[snapshot_date])\nRETURN\n    DIVIDE(\n        CALCULATE(\n            MAX('basket_savings'[potential_saving_pct]),\n            'basket_savings'[snapshot_date] = Fecha,\n            'basket_savings'[comparison_level] = \"BANNER\"\n        ),\n        100\n    )",
            "formatString": "0.0%"
          },
          {
            "name": "Salud cadena-dia",
            "description": "Porcentaje de cadenas saludables en el ultimo corte.",
            "expression": "VAR Fecha = MAXX(ALL('banner_health'), 'banner_health'[snapshot_date])\nVAR Saludables =\n    CALCULATE(\n        COUNTROWS(FILTER('banner_health', 'banner_health'[source_healthy] = TRUE())),\n        'banner_health'[snapshot_date] = Fecha\n    )\nVAR Total = CALCULATE(COUNTROWS('banner_health'), 'banner_health'[snapshot_date] = Fecha)\nRETURN\n    DIVIDE(Saludables, Total)",
            "formatString": "0.0%"
          },
          {
            "name": "Cobertura tiendas",
            "description": "Cobertura mediana de tiendas reportantes.",
            "expression": "MEDIAN('source_health'[store_coverage_ratio])",
            "formatString": "0.0%"
          },
          {
            "name": "Precios invalidos",
            "description": "Filas con precio de lista invalido en el ultimo corte.",
            "expression": "VAR Fecha = MAXX(ALL('source_health'), 'source_health'[snapshot_date])\nRETURN\n    CALCULATE(SUM('source_health'[invalid_list_price_rows]), 'source_health'[snapshot_date] = Fecha)",
            "formatString": "#,0"
          },
          {
            "name": "Dispersion limpia",
            "description": "Dispersion mediana del ultimo corte publicable luego de excluir precios criticos.",
            "expression": "VAR EsCadena = ISINSCOPE('dispersion_entity'[banner_label])\nVAR Fecha =\n    IF(\n        EsCadena,\n        MAXX(\n            FILTER(\n                ALL('dispersion_entity'),\n                'dispersion_entity'[coverage_status] = \"PUBLISHABLE\"\n                    && 'dispersion_entity'[dispersion_level] = \"BANNER\"\n            ),\n            'dispersion_entity'[snapshot_date]\n        ),\n        MAXX(\n            FILTER(\n                ALL('dispersion_entity'),\n                'dispersion_entity'[coverage_status] = \"PUBLISHABLE\"\n            ),\n            'dispersion_entity'[snapshot_date]\n        )\n    )\nRETURN\n    IF(\n        EsCadena,\n        CALCULATE(\n            MEDIAN('dispersion_entity'[median_dispersion_clean]),\n            'dispersion_entity'[snapshot_date] = Fecha,\n            'dispersion_entity'[coverage_status] = \"PUBLISHABLE\",\n            'dispersion_entity'[dispersion_level] = \"BANNER\"\n        ),\n        CALCULATE(\n            MEDIAN('dispersion_entity'[median_dispersion_clean]),\n            'dispersion_entity'[snapshot_date] = Fecha,\n            'dispersion_entity'[coverage_status] = \"PUBLISHABLE\"\n        )\n    )",
            "formatString": "0.0%"
          },
          {
            "name": "Productos dispersion publicables",
            "description": "Productos incluidos en entidades publicables del ultimo corte disponible.",
            "expression": "VAR Fecha =\n    MAXX(\n        FILTER(\n            ALL('dispersion_entity'),\n            'dispersion_entity'[coverage_status] = \"PUBLISHABLE\"\n        ),\n        'dispersion_entity'[snapshot_date]\n    )\nRETURN\n    CALCULATE(\n        SUM('dispersion_entity'[publishable_products]),\n        'dispersion_entity'[snapshot_date] = Fecha,\n        'dispersion_entity'[coverage_status] = \"PUBLISHABLE\"\n    )",
            "formatString": "#,0"
          },
          {
            "name": "Fallas altas",
            "description": "Filas fallidas en controles de severidad alta.",
            "expression": "CALCULATE(SUM('quality_checks'[failed_rows]), 'quality_checks'[severity] = \"high\")",
            "formatString": "#,0"
          },
          {
            "name": "Contribucion driver top 3",
            "description": "Contribucion logaritmica de los tres principales drivers del ultimo corte.",
            "expression": "VAR Fecha = MAXX(ALL('index_drivers'), 'index_drivers'[snapshot_date])\nRETURN\n    CALCULATE(\n        SUM('index_drivers'[contribution_log_points]),\n        'index_drivers'[snapshot_date] = Fecha,\n        KEEPFILTERS('index_drivers'[driver_rank] <= 3)\n    )",
            "formatString": "0.000"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "Calendario_index_daily",
        "toTable": "Calendario",
