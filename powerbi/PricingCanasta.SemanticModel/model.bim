              "type": "m",
              "expression": "let\n    Source = Csv.Document(File.Contents(DataFolder & \"index_daily.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n    TypedColumns = Table.TransformColumnTypes(\n        PromotedHeaders,\n        {\n        {\"build_id\", type text},\n        {\"scope_version\", type text},\n        {\"snapshot_date\", type date},\n        {\"id_comercio\", type text},\n        {\"id_bandera\", type text},\n        {\"price_index\", type number},\n        {\"common_gtins\", Int64.Type},\n        {\"catalog_gtins\", Int64.Type},\n        {\"shared_catalog_pct\", type number},\n        {\"publishable\", type logical},\n        {\"banner_label\", type text}\n        },\n        \"en-US\"\n    )\nin\n    TypedColumns"
